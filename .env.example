# SmartHire — local configuration
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed; this example file is the only one that is tracked.
#
#     Windows        copy .env.example .env
#     macOS / Linux  cp .env.example .env
#
# The launchers (run.bat / run.command) will offer to create `.env` and write
# your token into it for you, so editing this by hand is optional.


# ── GitHub token ────────────────────────────────────────────────────────────
# Turns the external-evidence channel from a toy into something usable:
# unauthenticated GitHub allows 60 requests/hour, which is not enough for a
# single pool of candidates. A token lifts that to 5000.
#
# Create one at https://github.com/settings/tokens with NO SCOPES TICKED.
# SmartHire only ever reads public repositories, so a token with zero
# permissions works perfectly — and leaks nothing if it escapes.
#
# Leave blank to run without external evidence; everything else still works,
# and the bundled synthetic profiles still demonstrate the feature offline.
GITHUB_TOKEN=


# ── Optional tuning ─────────────────────────────────────────────────────────

# Find a GitHub account from the email on a resume when no profile link is
# given. Best-effort and inherently uncertain, so evidence found this way is
# damped and always labelled as an inferred handle. Set to 0 to disable.
SMARTHIRE_EMAIL_LOOKUP=1

# Semantic backend: "minilm" (default) or "tfidf_svd" for the offline fallback.
# SMARTHIRE_SEMANTIC=minilm

# Compute device: "cpu" (default), "mps" on Apple Silicon, "cuda" with an NVIDIA GPU.
# SMARTHIRE_DEVICE=cpu
